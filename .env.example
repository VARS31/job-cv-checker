# Each agent's model, read once when the agent starts.
# A name starting with "claude-" (e.g. claude-haiku-5-5) means Claude: cloud, paid, and the job ad,
# CV text and letter are sent to Anthropic. Any other name means a local model in Ollama.
# scripts/start_agents.py --preset local|haiku overrides these four for the agents it starts.
JOB_ANALYST_MODEL=ministral-3:8b
CV_MATCHER_MODEL=ministral-3:8b
COVER_LETTER_MODEL=ministral-3:8b
REVIEWER_MODEL=granite4.1:8b

# Local models
OLLAMA_URL=http://localhost:11434

# true = save the exact requests sent to a local model in results/<model>/prompts/
MODEL_DEBUG=false

# Claude (optional). Only needed when an agent uses a claude-... model; such an agent
# checks the key at startup and doesn't start without a working key. Never commit it.
ANTHROPIC_API_KEY=

# Budget guard for Claude calls, in dollars. Spend is counted in results/cloud_spend.json.
BUDGET_PER_RUN_USD=0.50
BUDGET_TOTAL_USD=3.00

# Agent URLs used by the orchestrator
JOB_ANALYST_URL=http://localhost:9001
CV_MATCHER_URL=http://localhost:9002
COVER_LETTER_URL=http://localhost:9003
APPLICATION_REVIEWER_URL=http://localhost:9004
