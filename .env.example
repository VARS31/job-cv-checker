JOB_ANALYST_MODEL=ministral-3:8b

# true = save the exact requests sent to the model in results/<model>/prompts/
MODEL_DEBUG=false

# Model for the CV Matcher agent
CV_MATCHER_MODEL=ministral-3:8b

# Model for the Cover Letter Writer agent
COVER_LETTER_MODEL=ministral-3:8b

# Agent URLs used by the orchestrator
JOB_ANALYST_URL=http://localhost:9001
CV_MATCHER_URL=http://localhost:9002
COVER_LETTER_URL=http://localhost:9003

# Application Reviewer agent
REVIEWER_MODEL=granite4.1:8b
APPLICATION_REVIEWER_URL=http://localhost:9004
